OLLAMA_HOST=http://localhost:11434
OLLAMA_VISION_MODEL=qwen3-vl:4b-instruct
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_NUM_PREDICT=512
OLLAMA_NUM_CTX=4096
GROQ_API_KEY=""
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=120
GROQ_MAX_IMAGE_BYTES=20971520
# Per-document Groq output ceilings. Keep these within your provider's TPM budget.
GROQ_ANSWER_SHEET_MAX_COMPLETION_TOKENS=2200
GROQ_QUESTION_PAPER_MAX_COMPLETION_TOKENS=3000
GROQ_RUBRIC_MAX_COMPLETION_TOKENS=2200
CAPTURE_SAMPLE_EVERY_N_FRAMES=5
CAPTURE_PAGE_CHANGE_THRESHOLD=18.0
CAPTURE_STABILITY_THRESHOLD=3.0
CAPTURE_STABLE_FRAMES_REQUIRED=3
CAPTURE_BLUR_THRESHOLD=80.0
CAPTURE_MIN_FRAMES_BETWEEN_SAVES=30
DATABASE_PATH=data/gradeassist.db
LOG_LEVEL=INFO
