OLLAMA_HOST=http://localhost:11434
OLLAMA_VISION_MODEL=qwen3-vl:4b-instruct
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_NUM_PREDICT=512
OLLAMA_NUM_CTX=4096
GROQ_API_KEY=""
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=120
GROQ_MAX_IMAGE_BYTES=20971520
# Per-document Groq output ceilings. Keep these within your provider's TPM budget.
GROQ_ANSWER_SHEET_MAX_COMPLETION_TOKENS=2200
GROQ_QUESTION_PAPER_MAX_COMPLETION_TOKENS=3000
GROQ_RUBRIC_MAX_COMPLETION_TOKENS=2200
# Local semantic matching uses BGE. The query instruction is applied only to
# rubric criteria; student-answer sentences are encoded as passages.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SEMANTIC_MATCH_THRESHOLD=0.65
# Optional teacher-controlled report email. Leave blank to disable sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
# Local demo only: set real demonstration inboxes before sending an email.
DEMO_SACHIN_EMAIL=
DEMO_RUFINA_EMAIL=
CAPTURE_SAMPLE_EVERY_N_FRAMES=5
CAPTURE_PAGE_CHANGE_THRESHOLD=18.0
CAPTURE_STABILITY_THRESHOLD=3.0
CAPTURE_STABLE_FRAMES_REQUIRED=3
CAPTURE_BLUR_THRESHOLD=80.0
CAPTURE_MIN_FRAMES_BETWEEN_SAVES=30
DATABASE_PATH=data/gradeassist.db
LOG_LEVEL=INFO
